#[cfg(target_os = "linux")]

mod glfw;

import glfw::{Monitor, Window};

impl Monitor {
    /// @brief Returns the `RRCrtc` of the specified monitor.
    ///
    /// @return The `RRCrtc` of the specified monitor, or `None` if an
    /// [error](@ref error_handling) occurred.
    ///
    /// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
    /// GLFW_PLATFORM_UNAVAILABLE.
    ///
    /// @thread_safety This function may be called from any thread.  Access is not
    /// synchronized.
    ///
    /// @since Added in version 3.1.
    ///
    /// @ingroup native
    pub func get_x11_adapter(mut self) c_ulong {
        return get_x11_adapter(self);
    }

    /// @brief Returns the `RROutput` of the specified monitor.
    ///
    /// @return The `RROutput` of the specified monitor, or `None` if an
    /// [error](@ref error_handling) occurred.
    ///
    /// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
    /// GLFW_PLATFORM_UNAVAILABLE.
    ///
    /// @thread_safety This function may be called from any thread.  Access is not
    /// synchronized.
    ///
    /// @since Added in version 3.1.
    ///
    /// @ingroup native
    pub func get_x11_monitor(mut self) c_ulong {
        return get_x11_monitor(self);
    }

    /// @brief Returns the `struct wl_output*` of the specified monitor.
    ///
    /// @return The `struct wl_output*` of the specified monitor, or `NULL` if an
    /// [error](@ref error_handling) occurred.
    ///
    /// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
    /// GLFW_PLATFORM_UNAVAILABLE.
    ///
    /// @thread_safety This function may be called from any thread.  Access is not
    /// synchronized.
    ///
    /// @since Added in version 3.2.
    ///
    /// @ingroup native
    pub func get_wayland_monitor(mut self) *void {
        return get_wayland_monitor(self);
    }
}

impl Window {
    /// @brief Returns the `Window` of the specified window.
    ///
    /// @return The `Window` of the specified window, or `None` if an
    /// [error](@ref error_handling) occurred.
    ///
    /// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
    /// GLFW_PLATFORM_UNAVAILABLE.
    ///
    /// @thread_safety This function may be called from any thread.  Access is not
    /// synchronized.
    ///
    /// @since Added in version 3.0.
    ///
    /// @ingroup native
    pub func get_x11_window(mut self) c_ulong {
        return get_x11_window(self);
    }

    /// @brief Returns the main `struct wl_surface*` of the specified window.
    ///
    /// @return The main `struct wl_surface*` of the specified window, or `NULL` if
    /// an [error](@ref error_handling) occurred.
    ///
    /// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
    /// GLFW_PLATFORM_UNAVAILABLE.
    ///
    /// @thread_safety This function may be called from any thread.  Access is not
    /// synchronized.
    ///
    /// @since Added in version 3.2.
    ///
    /// @ingroup native
    pub func get_wayland_window(mut self) *void {
        return get_wayland_window(self);
    }
}

/// @brief Returns the `Display` used by GLFW.
///
/// @return The `Display` used by GLFW, or `NULL` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.0.
///
/// @ingroup native
#[extern, link_name("glfwGetX11Display")]
pub func get_x11_display() *void;

/// @brief Returns the `RRCrtc` of the specified monitor.
///
/// @return The `RRCrtc` of the specified monitor, or `None` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.1.
///
/// @ingroup native
#[extern, link_name("glfwGetX11Adapter")]
pub func get_x11_adapter(monitor: mut *Monitor) c_ulong;

/// @brief Returns the `RROutput` of the specified monitor.
///
/// @return The `RROutput` of the specified monitor, or `None` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.1.
///
/// @ingroup native
#[extern, link_name("glfwGetX11Monitor")]
pub func get_x11_monitor(monitor: mut *Monitor) c_ulong;

/// @brief Returns the `Window` of the specified window.
///
/// @return The `Window` of the specified window, or `None` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.0.
///
/// @ingroup native
#[extern, link_name("glfwGetX11Window")]
pub func get_x11_window(window: mut *Window) c_ulong;

/// @brief Sets the current primary selection to the specified string.
///
/// @param[in] string A UTF-8 encoded string.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED, @ref
/// GLFW_PLATFORM_UNAVAILABLE and @ref GLFW_PLATFORM_ERROR.
///
/// @pointer_lifetime The specified string is copied before this function
/// returns.
///
/// @thread_safety This function must only be called from the main thread.
///
/// @sa @ref clipboard
/// @sa glfwGetX11SelectionString
/// @sa glfwSetClipboardString
///
/// @since Added in version 3.3.
///
/// @ingroup native
#[extern, link_name("glfwSetX11SelectionString")]
pub func set_x11_selection_string(string: *u8);

/// @brief Returns the contents of the current primary selection as a string.
///
/// If the selection is empty or if its contents cannot be converted, `NULL`
/// is returned and a @ref GLFW_FORMAT_UNAVAILABLE error is generated.
///
/// @return The contents of the selection as a UTF-8 encoded string, or `NULL`
/// if an [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED, @ref
/// GLFW_PLATFORM_UNAVAILABLE and @ref GLFW_PLATFORM_ERROR.
///
/// @pointer_lifetime The returned string is allocated and freed by GLFW. You
/// should not free it yourself. It is valid until the next call to @ref
/// glfwGetX11SelectionString or @ref glfwSetX11SelectionString, or until the
/// library is terminated.
///
/// @thread_safety This function must only be called from the main thread.
///
/// @sa @ref clipboard
/// @sa glfwSetX11SelectionString
/// @sa glfwGetClipboardString
///
/// @since Added in version 3.3.
///
/// @ingroup native
#[extern, link_name("glfwGetX11SelectionString")]
pub func get_x11_selection_string() *u8;

/// @brief Returns the `struct wl_display*` used by GLFW.
///
/// @return The `struct wl_display*` used by GLFW, or `NULL` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.2.
///
/// @ingroup native
#[extern, link_name("glfwGetWaylandDisplay")]
pub func get_wayland_display() *void;

/// @brief Returns the `struct wl_output*` of the specified monitor.
///
/// @return The `struct wl_output*` of the specified monitor, or `NULL` if an
/// [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.2.
///
/// @ingroup native
#[extern, link_name("glfwGetWaylandMonitor")]
pub func get_wayland_monitor(monitor: mut *Monitor) *void;

/// @brief Returns the main `struct wl_surface*` of the specified window.
///
/// @return The main `struct wl_surface*` of the specified window, or `NULL` if
/// an [error](@ref error_handling) occurred.
///
/// @errors Possible errors include @ref GLFW_NOT_INITIALIZED and @ref
/// GLFW_PLATFORM_UNAVAILABLE.
///
/// @thread_safety This function may be called from any thread.  Access is not
/// synchronized.
///
/// @since Added in version 3.2.
///
/// @ingroup native
#[extern, link_name("glfwGetWaylandWindow")]
pub func get_wayland_window(window: mut *Window) *void;
